FROM apache/airflow:2.10.3-python3.12

# Pipeline in an isolated virtualenv: it needs SQLAlchemy 2.x, Airflow 2.10 pins 1.4
USER root
RUN python -m venv /opt/bvb && chown -R airflow: /opt/bvb
USER airflow
COPY --chown=airflow pyproject.toml /src/
COPY --chown=airflow src /src/src
RUN /opt/bvb/bin/pip install --no-cache-dir /src
